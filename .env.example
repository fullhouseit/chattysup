# ---------------------------------------------------------------------------
# ChattySup configuration.
#
#   cp .env.example .env
#
# The file is read from the repository root or from backend/ — whichever is
# next to the process you start. Every value below is optional; the defaults
# shown are what the app uses when the variable is absent.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_NAME=ChattySup
ENVIRONMENT=production
DEBUG=false

# Public URL of this installation — used to build the Telegram webhook
# callback. Must be reachable over HTTPS if you use webhook mode.
BASE_URL=http://localhost:8000

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset and every restart invalidates all sessions.
SECRET_KEY=change-me-in-production

# Session lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Self-service signup. The very first user can always register (and becomes the
# super admin) even when this is false.
ENABLE_REGISTRATION=false

# Comma separated list, or * for any origin. Only matters when the SPA is
# served from a different host than the API.
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------
# sqlite+aiosqlite:///./chattysup.db
# postgresql+asyncpg://user:password@host:5432/chattysup
DATABASE_URL=sqlite+aiosqlite:///./chattysup.db

# --- Storage ---------------------------------------------------------------
# Where message attachments are written. Relative paths resolve against the
# process working directory.
STORAGE_PATH=./storage
# Upload limit in bytes (default 50 MB).
MAX_UPLOAD_SIZE=52428800

# --- Email notifications ---------------------------------------------------
# Agents can be emailed the text of every new message, with a link straight to
# the conversation. Two switches must both be on: these credentials, and the
# in-app toggle under Settings -> Email notifications. Each agent then controls
# what reaches their own inbox on their profile page.
#
# Leave SMTP_HOST empty to disable outgoing mail entirely.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=helpdesk@example.com
# SMTP_PASSWORD=app-specific-password
# starttls (587, the usual choice) | ssl (465) | none (25)
# SMTP_SECURITY=starttls
# Envelope sender. Falls back to SMTP_USERNAME when that is an address.
# SMTP_FROM_EMAIL=helpdesk@example.com
# SMTP_FROM_NAME=Acme Support
# SMTP_TIMEOUT=15
#
# BASE_URL above is what the "Open conversation" link points at, so set it to
# the URL your agents actually use.

# --- Networking ------------------------------------------------------------
# Default outbound proxy for channels that do not define their own.
# Each inbox can override it in its own settings.
# HTTP_PROXY=http://user:password@proxy.example.com:3128
# HTTP_PROXY=socks5://127.0.0.1:1080

# --- Workers ---------------------------------------------------------------
# Run the channel pollers and the scheduler inside the API process. Set to
# false when you run `python -m app.workers.runner` as a separate service.
RUN_WORKERS=true
# How often snoozed conversations are woken and idle ones auto-resolved.
AUTOMATION_TICK_SECONDS=30
