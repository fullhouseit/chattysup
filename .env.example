# ---------------------------------------------------------------------------
# ChattySup configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Public URL of this installation — used to build Telegram webhook callbacks.
BASE_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Self-service signup. The very first user can always register (and becomes the
# super admin) even when this is false.
ENABLE_REGISTRATION=false

# sqlite+aiosqlite:///./chattysup.db  |  postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./chattysup.db

# Where attachments are stored.
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=52428800

# Comma separated list, or * for any origin.
CORS_ORIGINS=*

# Default outbound proxy for every channel that does not define its own.
# HTTP_PROXY=http://user:password@proxy.example.com:3128

# Run the channel pollers inside the API process. Set to false when you run
# `python -m app.workers.runner` as a separate service.
RUN_WORKERS=true
AUTOMATION_TICK_SECONDS=30

ENVIRONMENT=production
DEBUG=false
